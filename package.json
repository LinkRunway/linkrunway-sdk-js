{
  "name": "@linkrunway/sdk",
  "version": "0.2.0",
  "description": "LinkRunway SDK for JavaScript and Node.js.",
  "license": "MIT",
  "author": "Kimeur Labs, LLC <support@linkrunway.com>",
  "homepage": "https://github.com/LinkRunway/linkrunway-sdk-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinkRunway/linkrunway-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/LinkRunway/linkrunway-sdk-js/issues",
    "email": "support@linkrunway.com"
  },
  "keywords": [
    "linkrunway",
    "attribution",
    "deep-links",
    "javascript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2020",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
